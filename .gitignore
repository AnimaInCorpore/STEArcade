# derived from the ROMs / reproducible: python port.py build <game>
build/
run/
release/
# unpacked from the archives by port.py prepare <game> (games/<game>/tools/prepare.py)
assets/roms/extracted/
*.pkl
*.png
__pycache__/
venv/
.DS_Store

# ...but documentation images are committed (per-game docs, legacy notes)
!games/*/docs/**/*.png
!legacy/**/*.png

# MAME writes its configuration and snapshots into the directory it runs in
cfg/
snap/
